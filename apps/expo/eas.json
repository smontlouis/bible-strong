{
  "cli": {
    "version": ">= 14.2.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "latest"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "latest"
      },
      "ios": { "simulator": true }
    },
    "staging": {
      "channel": "staging",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production"
    },
    "production-apk": {
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "app-check-beta": {
      "extends": "production",
      "channel": "app-check-beta",
      "environment": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "ANDROID_APP_CHECK_BETA": "true",
        "ANDROID_GOOGLE_SERVICES_FILE": "firebase/prod/google-services.json",
        "APP_NAME": "Bible Strong",
        "EAS_BUILD_CHANNEL": "app-check-beta"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "1454738221"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
