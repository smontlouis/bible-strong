{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bible-strong-world",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": { "bindings": [{ "name": "WorldRoom", "class_name": "WorldRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldRoom"] }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*", "/health"],
  },
  "vars": { "ALLOWED_ORIGINS": "http://localhost:5186,http://127.0.0.1:5186" },
  "observability": { "enabled": true },
}
