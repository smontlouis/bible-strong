rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth.uid != null;  
    }
    match /stats/{document=**} {
    	allow read: if true;
    }
    match /studies/{studyId} {
    	allow create, update: if request.resource.data.user.id == request.auth.uid;
    	allow delete: if resource.data.user.id == request.auth.uid;
    }
    match /users/{userId} {
      allow write: if userId == request.auth.uid;
    }
    match /users-status/{userId} {
      allow write: if userId == request.auth.uid;
    }
    match /commentaries-FR/{commentaryId} {
      allow write: if true;
      allow read: if true;
    }
    match /changelog/{changelog} {
      allow read: if true;
    }
    match /verse-commentaries/{document=**} {
      allow read: if true;
    }
    match /plans/{document=**} {
      allow read: if true;
      allow update: if (request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['downloads']));
    }
  }
}