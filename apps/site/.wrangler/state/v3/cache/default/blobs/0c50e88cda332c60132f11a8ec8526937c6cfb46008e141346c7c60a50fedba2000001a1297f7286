Commentaries:$R[95]=[],study:$R[96]={versions:$R[97]=[$R[98]={label:"Bible Segond 21 (S21)",path:"/bible/s21/rom/8/28",text:"Du reste, nous savons que tout contribue au bien de ceux qui aiment Dieu, de ceux qui sont appelés conformément à son plan."},$R[99]={label:"Bible du Semeur (BDS)",path:"/bible/bds/rom/8/28",text:"Nous savons en outre que Dieu fait concourir toutes choses au bien de ceux qui l’aiment, de ceux qui ont été appelés conformément au plan divin."},$R[100]={label:"Nouvelle Edition de Genève 1979 (NEG79)",path:"/bible/neg79/rom/8/28",text:"Nous savons, du reste, que toutes choses concourent au bien de ceux qui aiment Dieu, de ceux qui sont appelés selon son dessein."},$R[101]={label:"Bible Darby (DBY)",path:"/bible/dby/rom/8/28",text:"– mais nous savons que toutes choses travaillent ensemble pour le bien de ceux qui aiment Dieu, de ceux qui sont appelés selon [son] propos."}],original:$R[102]={text:"Οἴδαμεν δὲ ὅτι τοῖς ἀγαπῶσιν τὸν θεὸν πάντα συνεργεῖ εἰς ἀγαθόν, τοῖς κατὰ πρόθεσιν κλητοῖς οὖσιν.",path:"/bible/bhg/interlinear/fr/rom/8/28"},words:$R[103]=[$R[104]={code:"G1492",path:"/strong/fr/g1492",label:"G1492",word:"savons",original:"εἴδω",transliteration:"eidō",gloss:"percevoir : comprendre"},$R[105]={code:"G1161",path:"/strong/fr/g1161",label:"G1161",word:"reste",original:"δέ",transliteration:"de",gloss:"alors"},$R[106]={code:"G3754G",path:"/strong/fr/g3754G",label:"G3754",word:"que",original:"ὅτι",transliteration:"hoti",gloss:"que/puisque"},$R[107]={code:"G3956",path:"/strong/fr/g3956",label:"G3956",word:"toutes",original:"πᾶς",transliteration:"pas",gloss:"tout"},$R[108]={code:"G4903",path:"/strong/fr/g4903",label:"G4903",word:"concourent",original:"συνεργέω",transliteration:"sunergeō",gloss:"œuvrer avec"},$R[109]={code:"G1519",path:"/strong/fr/g1519",label:"G1519",word:"au",original:"εἰς",transliteration:"eis",gloss:"vers"},$R[110]={code:"G0018",path:"/strong/fr/g0018",label:"G18",word:"bien",original:"ἀγαθός",transliteration:"agathos",gloss:"b