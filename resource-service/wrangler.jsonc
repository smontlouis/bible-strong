{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bible-strong-resources-api",
  "main": "src/runtime/worker.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.bible-strong.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1,
    },
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8d808a268c90412aa69ec2f59e40725f",
    },
  ],
}
