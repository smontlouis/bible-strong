# Copy this file to .env.resource-publication.local and fill the protected values locally.
RESOURCE_DATABASE_URL=postgresql://resource_publisher:replace-me@replace-me.neon.tech/neondb?sslmode=require
RESOURCE_R2_BUCKET=bible-strong-resource-artifacts-prod

# Registered Firebase App Check debug credential used only to mint short-lived smoke tokens.
RESOURCE_APP_CHECK_DEBUG_TOKEN=replace-me
RESOURCE_FIREBASE_PROJECT_ID=bible-strong-app
RESOURCE_FIREBASE_APP_ID=replace-me
RESOURCE_FIREBASE_API_KEY=replace-me

# Optional when Wrangler is not already authenticated locally with `yarn wrangler login`.
# CLOUDFLARE_ACCOUNT_ID=replace-me
# CLOUDFLARE_API_TOKEN=replace-me
