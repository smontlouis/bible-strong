{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"],
  "exclude": [
    "node_modules",
    "src/runtime/worker.ts",
    "src/runtime/__tests__/worker.node-test.ts",
    "worker-configuration.d.ts"
  ]
}
