{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "~assets/*": ["../../apps/mobile/src/assets/*"],
      "~common/*": ["../../apps/mobile/src/common/*"],
      "~features/*": ["../../apps/mobile/src/features/*"],
      "~helpers/*": ["../../apps/mobile/src/helpers/*"],
      "~i18n": ["../../apps/mobile/i18n"]
    }
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"],
  "exclude": [
    "node_modules",
    "src/runtime/worker.ts",
    "src/runtime/__tests__/worker.node-test.ts",
    "worker-configuration.d.ts"
  ]
}
