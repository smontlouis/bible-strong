{
  "name": "@bible-strong/resource-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test src/*/__tests__/*.node-test.ts",
    "test:integration": "RESOURCE_INTEGRATION=1 tsx --test --test-concurrency=1 src/*/__tests__/*.integration.node-test.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f compose.yaml up -d --wait",
    "db:down": "docker compose -f compose.yaml down",
    "db:reset": "docker compose -f compose.yaml down --volumes",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "bundle:validate": "tsx src/publication/publicationCli.ts validate",
    "import": "tsx src/publication/publicationCli.ts import",
    "import:all": "tsx src/publication/publicationCli.ts import-all",
    "import:catalog": "tsx src/publication/publicationCli.ts import-catalog",
    "import:catalog:hosted": "tsx src/publication/publicationCli.ts import-catalog-hosted",
    "publish:r2": "tsx src/publication/r2PublicationCli.ts",
    "publish:r2:changed": "tsx src/publication/r2PublicationCli.ts --changed",
    "publish:bible": "tsx src/publication/biblePublicationWorkflowCli.ts",
    "serve": "tsx src/runtime/node.ts",
    "serve:artifacts": "tsx src/runtime/artifactNode.ts",
    "worker:types": "wrangler types --config wrangler.jsonc worker-configuration.d.ts",
    "worker:types:check": "wrangler types --check --config wrangler.jsonc worker-configuration.d.ts",
    "worker:check": "yarn worker:types:check && tsc --project tsconfig.worker.json",
    "worker:deploy": "wrangler deploy --config wrangler.jsonc",
    "dev": "tsx src/runtime/dev.ts",
    "dev:local": "RESOURCE_SKIP_IMPORT=1 RESOURCE_API_PORT=8787 yarn dev",
    "topics:import": "tsx src/search/topicIngestionCli.ts",
    "topics:benchmark": "tsx src/search/topicSearchBenchmarkCli.ts",
    "analytics:search": "tsx src/analytics/searchAnalyticsReportCli.ts",
    "topics:embeddings:dev": "wrangler dev --config wrangler.embedding.jsonc --port 8791"
  },
  "dependencies": {
    "@bible-strong/bible-reference-parser": "workspace:*",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@neondatabase/serverless": "1.0.2",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.1",
    "fflate": "0.8.2",
    "jose": "6.2.9",
    "kysely": "0.29.5",
    "kysely-neon": "3.0.0",
    "pg": "8.23.0",
    "snowball-stemmers": "0.6.0",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/node": "^22.15.29",
    "@types/pg": "8.20.0",
    "@types/sql.js": "^1.4.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.20.6",
    "typescript": "~6.0.3",
    "wrangler": "^4.124.0"
  }
}
