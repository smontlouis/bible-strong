{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "workspace",
        "@bible-strong/site",
        "exec",
        "vite",
        "dev",
        "--port",
        "3210"
      ],
      "port": 3210
    },
    {
      "name": "share-cards",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "workspace",
        "@bible-strong/share-card-service",
        "wrangler",
        "dev",
        "--config",
        "wrangler.jsonc",
        "--port",
        "8799",
        "--var",
        "SITE_ORIGIN:http://localhost:3210"
      ],
      "port": 8799
    },
    {
      "name": "strobi-proto-fr",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "/Users/stephane/Projects/bible-strong/bible-strong-pitch/video/minimax/fr/player"
      ],
      "port": 8765
    },
    {
      "name": "site-cards",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SHARE_CARD_SECRET=local-development-secret",
        "CLOUDFLARE_INCLUDE_PROCESS_ENV=true",
        "yarn",
        "workspace",
        "@bible-strong/site",
        "exec",
        "vite",
        "dev",
        "--port",
        "3210"
      ],
      "port": 3210
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLOUDFLARE_INCLUDE_PROCESS_ENV=true",
        "SHARE_CARD_SECRET=local-development-secret",
        "yarn",
        "workspace",
        "@bible-strong/site",
        "exec",
        "vite",
        "preview",
        "--port",
        "3212"
      ],
      "port": 3212
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "workspace",
        "@bible-strong/expo",
        "web"
      ],
      "port": 9090
    },
    {
      "name": "expo-metro",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "workspace",
        "@bible-strong/expo",
        "start"
      ],
      "port": 8081
    },
    {
      "name": "world-client",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "workspace",
        "@bible-strong/world",
        "dev:client"
      ],
      "port": 5186
    },
    {
      "name": "portrait-atlas",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "/Users/stephane/Projects/bible-strong/portraits"
      ],
      "port": 8766
    },
    {
      "name": "resource-api-neon",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "RESOURCE_API_PORT=8788",
        "yarn",
        "workspace",
        "@bible-strong/resource-service",
        "dotenv",
        "-e",
        ".env.resource-publication.local",
        "--",
        "tsx",
        "src/runtime/node.ts"
      ],
      "port": 8788
    },
    {
      "name": "site-local-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CLOUDFLARE_INCLUDE_PROCESS_ENV=true",
        "RESOURCE_API_URL=http://127.0.0.1:8788",
        "yarn",
        "workspace",
        "@bible-strong/site",
        "exec",
        "vite",
        "dev",
        "--port",
        "3214"
      ],
      "port": 3214
    },
    {
      "name": "desktop-web",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "workspace",
        "@bible-strong/desktop",
        "web:dev"
      ],
      "port": 9090
    }
  ]
}
