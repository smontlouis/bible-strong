{
  "name": "@bible-strong/workspace",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "apps/api/functions",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "yarn workspace @bible-strong/mobile start",
    "dev:web": "yarn workspace @bible-strong/web dev",
    "dev:api": "yarn workspace @bible-strong/api serve",
    "dev:studio": "yarn workspace @bible-strong/resource-studio dev",
    "dev:resources": "yarn workspace @bible-strong/resource-service dev",
    "build": "yarn workspace @bible-strong/api-functions build && yarn workspace @bible-strong/web build",
    "typecheck": "yarn workspace @bible-strong/resource-domain typecheck && yarn workspace @bible-strong/resource-catalog typecheck && yarn workspace @bible-strong/mobile typecheck && yarn workspace @bible-strong/web typecheck && yarn workspace @bible-strong/api-functions typecheck && yarn workspace @bible-strong/resource-studio typecheck && yarn workspace @bible-strong/resource-service typecheck",
    "lint": "yarn workspace @bible-strong/mobile lint && yarn workspace @bible-strong/web lint && yarn workspace @bible-strong/api-functions lint",
    "test": "yarn workspace @bible-strong/resource-domain test && yarn workspace @bible-strong/resource-catalog test && yarn workspace @bible-strong/mobile test && yarn workspace @bible-strong/resource-service test",
    "format:check": "yarn workspace @bible-strong/mobile format:check",
    "resources:test": "yarn workspace @bible-strong/resource-service test",
    "resources:test:integration": "yarn workspace @bible-strong/resource-service test:integration",
    "resources:architecture:check": "node scripts/check-resource-package-boundaries.mjs && yarn workspace @bible-strong/resource-service architecture:check && yarn workspace @bible-strong/mobile resources:ui:architecture:check",
    "resources:db:up": "yarn workspace @bible-strong/resource-service db:up",
    "resources:db:down": "yarn workspace @bible-strong/resource-service db:down",
    "resources:db:reset": "yarn workspace @bible-strong/resource-service db:reset",
    "resources:migrate": "yarn workspace @bible-strong/resource-service migrate",
    "resources:bundle:validate": "yarn workspace @bible-strong/resource-service bundle:validate",
    "resources:import": "yarn workspace @bible-strong/resource-service import",
    "resources:import-all": "yarn workspace @bible-strong/resource-service import:all",
    "resources:import-catalog": "yarn workspace @bible-strong/resource-service import:catalog",
    "resources:r2:publish-changed": "yarn workspace @bible-strong/resource-service publish:r2:changed",
    "resources:serve": "yarn workspace @bible-strong/resource-service serve",
    "resources:worker:check": "yarn workspace @bible-strong/resource-service worker:check",
    "agents:start:logged": "node scripts/agents-start-logged.mjs",
    "agents:architecture": "node scripts/agents-architecture-lint.mjs",
    "agents:architecture:check": "node scripts/agents-architecture-lint.mjs --check",
    "agents:styles:check": "node scripts/agents-style-lint.mjs",
    "agents:quality": "node scripts/agents-quality-report.mjs",
    "agents:quality:check": "node scripts/agents-quality-report.mjs --check",
    "agents:logs:clear": "node scripts/agents-log-session.mjs clear",
    "agents:logs:all": "node scripts/agents-log-session.mjs all",
    "agents:logs:errors": "node scripts/agents-log-session.mjs errors",
    "agents:logs:startup": "node scripts/agents-log-session.mjs startup",
    "agents:logs:navigation": "node scripts/agents-log-session.mjs navigation",
    "agents:issue:start": "node scripts/agents-issue-start.mjs",
    "agents:issue:pr": "node scripts/agents-issue-pr.mjs",
    "agents:issue:run": "node scripts/agents-issue-run.mjs",
    "docs:flows:data": "node docs/assets/app-flows/scripts/generate-app-flow-data.mjs",
    "docs:flows:build": "yarn docs:flows:data && yarn workspace @bible-strong/mobile vite build --config ../../docs/assets/app-flows/viewer/vite.config.mjs",
    "docs:flows:dev": "yarn docs:flows:data && yarn workspace @bible-strong/mobile vite --config ../../docs/assets/app-flows/viewer/vite.config.mjs",
    "resources:commentaries:export": "yarn workspace @bible-strong/resource-studio commentaries:export",
    "resources:commentaries:audit": "yarn workspace @bible-strong/resource-studio commentaries:audit",
    "resources:commentaries:export-waves": "yarn workspace @bible-strong/resource-studio commentaries:export-waves",
    "resources:commentaries:audit-waves": "yarn workspace @bible-strong/resource-studio commentaries:audit-waves",
    "resources:commentaries:export-bible-annotee": "yarn workspace @bible-strong/resource-studio commentaries:export-bible-annotee",
    "resources:commentaries:audit-bible-annotee": "yarn workspace @bible-strong/resource-studio commentaries:audit-bible-annotee",
    "resources:commentaries:install-bible-annotee": "yarn workspace @bible-strong/resource-studio commentaries:install-bible-annotee",
    "resources:commentaries:export-wave-3": "yarn workspace @bible-strong/resource-studio commentaries:export-wave-3",
    "resources:commentaries:audit-wave-3": "yarn workspace @bible-strong/resource-studio commentaries:audit-wave-3",
    "resources:commentaries:install-wave-3": "yarn workspace @bible-strong/resource-studio commentaries:install-wave-3",
    "resources:commentaries:export-douay-rheims": "yarn workspace @bible-strong/resource-studio commentaries:export-douay-rheims",
    "resources:commentaries:install-douay-rheims": "yarn workspace @bible-strong/resource-studio commentaries:install-douay-rheims",
    "resources:commentaries:prepare-translations": "yarn workspace @bible-strong/resource-studio commentaries:prepare-translations",
    "resources:commentaries:prepare-translations:remaining": "yarn workspace @bible-strong/resource-studio commentaries:prepare-translations:remaining",
    "resources:commentaries:validate-translations": "yarn workspace @bible-strong/resource-studio commentaries:validate-translations",
    "resources:commentaries:apply-translations": "yarn workspace @bible-strong/resource-studio commentaries:apply-translations",
    "resources:commentaries:build-library": "yarn workspace @bible-strong/resource-studio commentaries:build-library",
    "resources:commentaries:normalize-scopes": "yarn workspace @bible-strong/resource-studio commentaries:normalize-scopes",
    "resources:commentaries:normalize-links": "yarn workspace @bible-strong/resource-studio commentaries:normalize-links",
    "resources:commentaries:test": "yarn workspace @bible-strong/resource-studio commentaries:test",
    "resources:commentaries:validate-library": "yarn workspace @bible-strong/resource-studio commentaries:validate-library",
    "resources:commentaries:validate": "yarn workspace @bible-strong/resource-studio commentaries:validate",
    "resources:commentaries:serve": "yarn workspace @bible-strong/resource-studio commentaries:serve"
  },
  "resolutions": {
    "react-native-svg": "15.15.4",
    "react-native-screens@npm:^4.25.2": "patch:react-native-screens@npm%3A4.25.2#~/.yarn/patches/react-native-screens-npm-4.25.2-0de6719d95.patch",
    "rn-fetch-blob@npm:^0.12.0": "patch:rn-fetch-blob@npm%3A0.12.0#~/.yarn/patches/rn-fetch-blob-npm-0.12.0-cf02e3c544.patch",
    "@expo/cli@npm:^56.1.16": "patch:@expo/cli@npm%3A56.1.16#~/.yarn/patches/@expo-cli-npm-56.1.16-7d7dd3fde0.patch",
    "@react-native-masked-view/masked-view@npm:^0.3.2": "patch:@react-native-masked-view/masked-view@npm%3A0.3.2#~/.yarn/patches/@react-native-masked-view-masked-view-npm-0.3.2-7e49df0087.patch"
  }
}
