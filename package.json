{
  "name": "bible-lexicon-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tools for building Bible lexicon data from Bible and Strong source files.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "generate:strong:reader": "tsx src/generateStrongReader.ts",
    "generate:strong:hybrid": "tsx src/generateStrongHybrid.ts",
    "evaluate:strong:hybrid": "tsx src/evaluateStrongHybrid.ts",
    "review:llm": "tsx src/llmReview.ts prepare",
    "review:llm:apply": "tsx src/llmReview.ts apply",
    "review:llm:books": "tsx src/runLlmReviewBooks.ts",
    "strong:goal:status": "tsx src/multiBibleStrongGoal.ts status",
    "strong:goal:merge-decisions": "tsx src/multiBibleStrongGoal.ts merge-decisions",
    "strong:goal:report": "tsx src/multiBibleStrongGoal.ts report",
    "compare:s21:concordance": "tsx src/compareS21Concordance.ts",
    "llm:transfer": "tsx src/llmReferenceTransfer.ts",
    "viewer": "tsx src/viewerServer.ts",
    "dictionaries:step": "tsx scripts/importStepBibleDictionaries.ts",
    "entities:step": "tsx scripts/importStepBibleEntities.ts",
    "benchmark:lexicon-translation": "tsx scripts/benchmarkLexiconTranslation.ts",
    "translate:lexicon:fr": "tsx scripts/translateLexiconFr.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
