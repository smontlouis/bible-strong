{
  "name": "bible-strong",
  "version": "27.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-pre-install": "corepack enable",
    "start": "expo start --dev-client",
    "update:staging": "npx eas update --channel staging",
    "update:production": "npx eas update --channel production",
    "build:android:dev": "rm -rf \"${TMPDIR}metro-cache\" && dotenv -c development -- eas build -p android --local --profile development --non-interactive",
    "build:android:staging": "rm -rf \"${TMPDIR}metro-cache\" && dotenv -c staging -- eas build -p android --local --profile staging --non-interactive",
    "build:android:prod": "rm -rf \"${TMPDIR}metro-cache\" && dotenv -c production -- eas build -p android --local --profile production --non-interactive",
    "build:android:prod:apk": "rm -rf \"${TMPDIR}metro-cache\" && dotenv -c production -- eas build -p android --local --profile production-apk --non-interactive",
    "build:ios:dev": "rm -rf \"${TMPDIR}metro-cache\" && dotenv -c development -- eas build -p ios --local --profile development --non-interactive",
    "build:ios:dev-sim": "rm -rf \"${TMPDIR}metro-cache\" && dotenv -c development -- eas build -p ios --local --profile development-simulator --non-interactive",
    "build:ios:staging": "rm -rf \"${TMPDIR}metro-cache\" && dotenv -c staging -- eas build -p ios --local --profile staging --non-interactive",
    "build:ios:prod": "rm -rf \"${TMPDIR}metro-cache\" && dotenv -c production -- eas build -p ios --local --profile production --non-interactive",
    "test:watch": "node ./node_modules/jest/bin/jest.js --watchAll",
    "test": "node ./node_modules/jest/bin/jest.js",
    "resources:test": "tsx --test resource-service/src/*/__tests__/*.node-test.ts",
    "resources:test:integration": "RESOURCE_INTEGRATION=1 tsx --test --test-concurrency=1 resource-service/src/*/__tests__/*.integration.node-test.ts",
    "resources:test:lsg": "RESOURCE_LSG_BUNDLE=resource-service/.local/publications/lsg tsx --test --test-concurrency=1 resource-service/src/*/__tests__/*completeLsg*.integration.node-test.ts",
    "resources:test:bibles": "RESOURCE_INTEGRATION=1 tsx --test --test-concurrency=1 resource-service/src/publication/__tests__/completeOrdinaryBiblePublications.integration.node-test.ts",
    "resources:test:strong": "RESOURCE_INTEGRATION=1 tsx --test --test-concurrency=1 resource-service/src/publication/__tests__/completeStrongBiblePublications.integration.node-test.ts",
    "resources:test:interlinear": "RESOURCE_INTEGRATION=1 tsx --test --test-concurrency=1 resource-service/src/publication/__tests__/completeInterlinearBiblePublications.integration.node-test.ts",
    "resources:test:lexicon": "RESOURCE_INTEGRATION=1 tsx --test --test-concurrency=1 resource-service/src/publication/__tests__/completeStrongLexiconPublications.integration.node-test.ts",
    "resources:smoke:lexicon": "node scripts/smokeStrongLexiconResourceService.mjs",
    "resources:smoke:dictionary": "node scripts/smokeDictionaryResourceService.mjs",
    "resources:smoke:nave": "node scripts/smokeNaveResourceService.mjs",
    "resources:smoke:nave:artifacts": "node scripts/smokeNaveResourceArtifacts.mjs",
    "resources:smoke:supplementary": "node scripts/smokeSupplementaryResourceService.mjs",
    "resources:smoke:supplementary:artifacts": "node scripts/smokeSupplementaryResourceArtifacts.mjs",
    "resources:smoke:timeline": "node scripts/smokeTimelineResourceService.mjs",
    "resources:smoke:timeline:artifacts": "node scripts/smokeTimelineResourceArtifacts.mjs",
    "resources:smoke:bible-search": "node scripts/smokeBibleSearchResourceService.mjs",
    "resources:smoke:local": "node scripts/smokeLocalResourcePlatform.mjs",
    "resources:architecture:check": "node scripts/check-resource-service-architecture.mjs && node scripts/check-resource-ui-architecture.mjs",
    "resources:db:up": "docker compose -f resource-service/compose.yaml up -d --wait",
    "resources:db:down": "docker compose -f resource-service/compose.yaml down",
    "resources:db:reset": "docker compose -f resource-service/compose.yaml down --volumes",
    "resources:generate": "drizzle-kit generate --config resource-service/drizzle.config.ts",
    "resources:migrate": "drizzle-kit migrate --config resource-service/drizzle.config.ts",
    "resources:bundle:validate": "tsx resource-service/src/publication/publicationCli.ts validate",
    "resources:import": "tsx resource-service/src/publication/publicationCli.ts import",
    "resources:import-all": "tsx resource-service/src/publication/publicationCli.ts import-all",
    "resources:import-catalog": "tsx resource-service/src/publication/publicationCli.ts import-catalog",
    "resources:import-catalog:hosted": "tsx resource-service/src/publication/publicationCli.ts import-catalog-hosted",
    "resources:r2:publish-catalog": "tsx resource-service/src/publication/r2PublicationCli.ts",
    "resources:r2:publish-catalog:prod": "RESOURCE_R2_BUCKET=bible-strong-resource-artifacts-prod yarn resources:r2:publish-catalog --root ../bible-lexicon-maker/outputs/resource-publications",
    "resources:serve": "tsx resource-service/src/runtime/node.ts",
    "resources:serve:artifacts": "tsx resource-service/src/runtime/artifactNode.ts",
    "resources:worker:types": "wrangler types --config resource-service/wrangler.jsonc resource-service/worker-configuration.d.ts",
    "resources:worker:types:check": "wrangler types --check --config resource-service/wrangler.jsonc resource-service/worker-configuration.d.ts",
    "resources:worker:check": "yarn resources:worker:types:check && tsc --project resource-service/tsconfig.worker.json",
    "resources:worker:deploy": "wrangler deploy --config resource-service/wrangler.jsonc",
    "resources:dev": "tsx resource-service/src/runtime/dev.ts",
    "resources:dev:local": "RESOURCE_SKIP_IMPORT=1 RESOURCE_API_PORT=8787 yarn resources:dev",
    "resources:sync:local": "yarn resources:db:up && yarn resources:migrate && RESOURCE_PUBLICATION_ROOTS=../bible-lexicon-maker/outputs/resource-publications yarn resources:import-catalog",
    "clean": "rm -rf pnpm-lock.json && rm -rf node_modules && rm -rf $TMPDIR/metro-* && rm -rf $TMPDIR/haste-map-* && pnpm && say I love react native",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\" \"docs/assets/app-flows/**/*.{html,js,jsx,mjs,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\" \"docs/assets/app-flows/**/*.{html,js,jsx,mjs,css}\"",
    "typecheck": "tsc --noEmit",
    "i18n": "i18next 'src/**/*.{js,ts,tsx}' '!src/features/bible/bibleWebView/**' '!src/features/studies/studiesWebView/**'",
    "agents:start:logged": "node scripts/agents-start-logged.mjs",
    "agents:architecture": "node scripts/agents-architecture-lint.mjs",
    "agents:architecture:check": "node scripts/agents-architecture-lint.mjs --check",
    "agents:styles:check": "node scripts/agents-style-lint.mjs",
    "agents:quality": "node scripts/agents-quality-report.mjs",
    "agents:quality:check": "node scripts/agents-quality-report.mjs --check",
    "agents:logs:clear": "node scripts/agents-log-session.mjs clear",
    "agents:logs:all": "node scripts/agents-log-session.mjs all",
    "agents:logs:errors": "node scripts/agents-log-session.mjs errors",
    "agents:logs:startup": "node scripts/agents-log-session.mjs startup",
    "agents:logs:navigation": "node scripts/agents-log-session.mjs navigation",
    "agents:issue:start": "node scripts/agents-issue-start.mjs",
    "agents:issue:pr": "node scripts/agents-issue-pr.mjs",
    "agents:issue:run": "node scripts/agents-issue-run.mjs",
    "docs:flows:data": "node docs/assets/app-flows/scripts/generate-app-flow-data.mjs",
    "docs:flows:build": "yarn docs:flows:data && vite build --config docs/assets/app-flows/viewer/vite.config.mjs",
    "docs:flows:dev": "yarn docs:flows:data && vite --config docs/assets/app-flows/viewer/vite.config.mjs",
    "bible:dbr:generate": "node scripts/generate-dbr-bible.mjs",
    "bible:lau:generate": "node scripts/generate-lau-bible.mjs",
    "bible:lxx:generate": "node scripts/generate-lxx-bibles.mjs",
    "bible:vul:generate": "node scripts/generate-vul-bible.mjs",
    "bible-project:collect": "node scripts/collect-bible-project-videos.mjs && node scripts/derive-bible-project-candidates.mjs && node scripts/derive-bible-project-book-overviews.mjs && node scripts/derive-bible-project-visual-commentaries.mjs && node scripts/derive-bible-project-word-studies.mjs && node scripts/derive-bible-project-themes.mjs && node scripts/generate-bible-project-presentation-data.mjs",
    "bible-project:derive": "node scripts/derive-bible-project-candidates.mjs",
    "bible-project:derive:books": "node scripts/derive-bible-project-book-overviews.mjs",
    "bible-project:derive:visual-commentaries": "node scripts/derive-bible-project-visual-commentaries.mjs",
    "bible-project:derive:word-studies": "node scripts/derive-bible-project-word-studies.mjs",
    "bible-project:derive:themes": "node scripts/derive-bible-project-themes.mjs",
    "bible-project:derive:presentation": "node scripts/generate-bible-project-presentation-data.mjs",
    "bible-project:transcripts": "node scripts/acquire-bible-project-transcripts.mjs",
    "bible-project:derive:anchor-dossiers": "node scripts/derive-bible-project-anchor-dossiers.mjs",
    "bible-project:prepare:anchor-agents": "node scripts/prepare-bible-project-anchor-agent-batches.mjs",
    "bible-project:aggregate:anchor-proposals": "node scripts/aggregate-bible-project-anchor-proposals.mjs",
    "bible-project:derive:associated-resources": "node scripts/derive-bible-project-associated-resources.mjs",
    "bible-project:curation:apply": "node scripts/apply-bible-project-curation.mjs",
    "bible-project:export:production": "node scripts/export-bible-project-production.mjs",
    "bible-project:anchors:prepare": "yarn bible-project:transcripts && yarn bible-project:derive:anchor-dossiers && yarn bible-project:prepare:anchor-agents",
    "bible-project:anchors:finalize": "yarn bible-project:aggregate:anchor-proposals && yarn bible-project:derive:associated-resources && yarn bible-project:derive:presentation",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
