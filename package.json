{
  "name": "bible-lexicon-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tools for building Bible lexicon data from Bible and Strong source files.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "generate:strong": "tsx src/generateStrong.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
