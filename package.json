{
  "name": "bible-lexicon-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tools for building Bible lexicon data from Bible and Strong source files.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "strong:generate": "tsx src/strongLedger.ts generate",
    "strong:refresh": "tsx src/strongLedger.ts refresh",
    "strong:export": "tsx src/strongLedger.ts export",
    "strong:diagnose": "tsx src/diagnoseStrong.ts",
    "strong:evaluate": "tsx src/evaluateStrongGold.ts",
    "strong:report:references": "tsx src/referenceCoverageReport.ts",
    "strong:lexical-candidates": "tsx src/lexicalCandidateReport.ts",
    "strong:lexical-candidates:apply": "tsx src/lexicalCandidateExperiment.ts",
    "strong:review:gaps": "tsx src/semanticRefill.ts",
    "strong:review:gaps:queue": "tsx src/semanticRefillQueue.ts",
    "strong:review:gaps:packet": "tsx src/semanticRefillAgentPacket.ts",
    "strong:review:gaps:apply": "tsx src/semanticRefillAgentReview.ts",
    "strong:review:llm": "tsx src/llmReview.ts prepare",
    "strong:review:llm:apply": "tsx src/llmReview.ts apply",
    "strong:review:llm:books": "tsx src/runLlmReviewBooks.ts",
    "strong:llm:transfer": "tsx src/llmReferenceTransfer.ts",
    "strong:references:export": "tsx src/exportReferenceStrongTsv.ts",
    "strong:step:enrich": "tsx src/enrichStrongTsvWithStep.ts",
    "strong:step:download-originals": "tsx src/downloadStepOriginals.ts",
    "strong:audit:plan": "tsx src/strongAuditWorkflow.ts plan",
    "strong:audit:run": "tsx src/strongAuditWorkflow.ts run",
    "strong:audit:snapshot": "tsx src/strongAuditWorkflow.ts snapshot",
    "strong:audit:verify": "tsx src/strongAuditWorkflow.ts verify",
    "strong:audit:residuals": "tsx src/strongAuditWorkflow.ts residuals",
    "strong:goal:status": "tsx src/multiBibleStrongGoal.ts status",
    "strong:goal:merge-decisions": "tsx src/multiBibleStrongGoal.ts merge-decisions",
    "strong:goal:report": "tsx src/multiBibleStrongGoal.ts report",
    "compare:s21:concordance": "tsx src/compareS21Concordance.ts",
    "viewer": "npm run viewer:build && tsx src/viewerServer.ts",
    "viewer:server": "tsx src/viewerServer.ts",
    "viewer:dev": "vite --host 0.0.0.0",
    "viewer:build": "vite build",
    "viewer:typecheck": "tsc -p tsconfig.web.json --noEmit",
    "dictionaries:step": "tsx scripts/importStepBibleDictionaries.ts",
    "entities:step": "tsx scripts/importStepBibleEntities.ts",
    "benchmark:lexicon-translation": "tsx scripts/benchmarkLexiconTranslation.ts",
    "benchmark:deepl:strict-fr": "tsx scripts/benchmarkDeepLStrictFr.ts",
    "generate:lexicon:fr:v2:deepl": "tsx scripts/generateLexiconFrV2DeepL.ts",
    "review:lexicon:fr:v2": "tsx scripts/generateLexiconFrV2ProductReview.ts",
    "generate:lexicon-resources:fr:deepl": "tsx scripts/generateLexiconResourceTranslationsDeepL.ts",
    "generate:lexicon-resources:fr:gemini": "tsx scripts/generateLexiconResourceTranslationsDeepL.ts --engine gemini --model google/gemini-3.1-flash-lite --out-jsonl outputs/lexicon-resource-fr/lexicon_resource_fr.gemini-flash-lite.candidates.jsonl --review-needed-json outputs/lexicon-resource-fr/lexicon_resource_fr.gemini-flash-lite.review-needed.json --report reports/lexicon-resource-fr-gemini-flash-lite-production.md",
    "import:lexicon-resources:translations": "tsx scripts/importLexiconResourceTranslations.ts",
    "generate:entities:fr:gemini": "tsx scripts/generateEntityTranslations.ts",
    "import:entities:translations": "tsx scripts/importEntityTranslations.ts",
    "generate:entities:display-names:fr:gemini": "tsx scripts/generateEntityDisplayNameTranslations.ts",
    "import:entities:display-names": "tsx scripts/importEntityDisplayNameTranslations.ts",
    "normalize:entities:names:fr": "tsx scripts/normalizeEntityTranslationNames.ts",
    "entities:production": "tsx scripts/buildProductionEntitiesDb.ts",
    "lexicon:production": "tsx scripts/hardenProductionLexicon.ts",
    "translate:lexicon:fr": "tsx scripts/translateLexiconFr.ts",
    "reclassify:lexicon:fr": "tsx scripts/reclassifyLexiconFrCandidates.ts",
    "finalize:lexicon:fr": "tsx scripts/finalizeLexiconFr.ts",
    "import:lexicon:translations": "tsx scripts/importLexiconTranslations.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.0"
  }
}
