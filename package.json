{
  "name": "bible-lexicon-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tools for building Bible lexicon data from Bible and Strong source files.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "generate:strong:reader": "tsx src/generateStrongReader.ts",
    "generate:strong:hybrid": "tsx src/generateStrongHybrid.ts",
    "generate:strong:enriched": "tsx src/enrichedStrongBible.ts generate",
    "export:strong:reader": "tsx src/enrichedStrongBible.ts export --mode reader",
    "export:strong:advanced": "tsx src/enrichedStrongBible.ts export --mode advanced",
    "strong:semantic-refill": "tsx src/semanticRefill.ts",
    "strong:semantic-refill:queue": "tsx src/semanticRefillQueue.ts",
    "strong:semantic-refill:agent-packet": "tsx src/semanticRefillAgentPacket.ts",
    "strong:semantic-refill:agent-review": "tsx src/semanticRefillAgentReview.ts",
    "generate:strong:references": "tsx src/exportReferenceStrongTsv.ts",
    "generate:strong:step": "tsx src/enrichStrongTsvWithStep.ts",
    "step:download-originals": "tsx src/downloadStepOriginals.ts",
    "evaluate:strong:hybrid": "tsx src/evaluateStrongHybrid.ts",
    "review:llm": "tsx src/llmReview.ts prepare",
    "review:llm:apply": "tsx src/llmReview.ts apply",
    "review:llm:books": "tsx src/runLlmReviewBooks.ts",
    "strong:v3:missing": "tsx src/semanticStrongV3.ts missing",
    "strong:v3:plan": "tsx src/semanticStrongV3.ts plan",
    "strong:v3:validate": "tsx src/semanticStrongV3.ts validate",
    "strong:goal:status": "tsx src/multiBibleStrongGoal.ts status",
    "strong:goal:merge-decisions": "tsx src/multiBibleStrongGoal.ts merge-decisions",
    "strong:goal:report": "tsx src/multiBibleStrongGoal.ts report",
    "compare:s21:concordance": "tsx src/compareS21Concordance.ts",
    "llm:transfer": "tsx src/llmReferenceTransfer.ts",
    "viewer": "tsx src/viewerServer.ts",
    "dictionaries:step": "tsx scripts/importStepBibleDictionaries.ts",
    "entities:step": "tsx scripts/importStepBibleEntities.ts",
    "benchmark:lexicon-translation": "tsx scripts/benchmarkLexiconTranslation.ts",
    "benchmark:deepl:strict-fr": "tsx scripts/benchmarkDeepLStrictFr.ts",
    "generate:lexicon:fr:v2:deepl": "tsx scripts/generateLexiconFrV2DeepL.ts",
    "review:lexicon:fr:v2": "tsx scripts/generateLexiconFrV2ProductReview.ts",
    "generate:lexicon-resources:fr:deepl": "tsx scripts/generateLexiconResourceTranslationsDeepL.ts",
    "generate:lexicon-resources:fr:gemini": "tsx scripts/generateLexiconResourceTranslationsDeepL.ts --engine gemini --model google/gemini-3.1-flash-lite --out-jsonl outputs/lexicon-resource-fr/lexicon_resource_fr.gemini-flash-lite.candidates.jsonl --review-needed-json outputs/lexicon-resource-fr/lexicon_resource_fr.gemini-flash-lite.review-needed.json --report reports/lexicon-resource-fr-gemini-flash-lite-production.md",
    "import:lexicon-resources:translations": "tsx scripts/importLexiconResourceTranslations.ts",
    "generate:entities:fr:gemini": "tsx scripts/generateEntityTranslations.ts",
    "import:entities:translations": "tsx scripts/importEntityTranslations.ts",
    "generate:entities:display-names:fr:gemini": "tsx scripts/generateEntityDisplayNameTranslations.ts",
    "import:entities:display-names": "tsx scripts/importEntityDisplayNameTranslations.ts",
    "normalize:entities:names:fr": "tsx scripts/normalizeEntityTranslationNames.ts",
    "entities:production": "tsx scripts/buildProductionEntitiesDb.ts",
    "lexicon:production": "tsx scripts/hardenProductionLexicon.ts",
    "translate:lexicon:fr": "tsx scripts/translateLexiconFr.ts",
    "reclassify:lexicon:fr": "tsx scripts/reclassifyLexiconFrCandidates.ts",
    "finalize:lexicon:fr": "tsx scripts/finalizeLexiconFr.ts",
    "import:lexicon:translations": "tsx scripts/importLexiconTranslations.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
