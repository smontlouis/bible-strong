@@ -1,4 +1,25 @@
 let cachedBaseUrl: string | null = null;
+/**
+ * Resolve a DOM component to its exact local update asset when possible.
+ * Expo Updates exposes a mix of embedded and downloaded assets on iOS, so
+ * deriving the DOM directory from an arbitrary asset is order-dependent.
+ */
+export function getDOMComponentURL(filePath: string): string {
+  const ExpoUpdates = globalThis.expo?.modules?.['ExpoUpdates'] as
+    | import('expo-updates').ExpoUpdatesModule
+    | undefined;
+  if (ExpoUpdates?.isEnabled && !ExpoUpdates.isEmbeddedLaunch) {
+    const normalizedFilePath = `/${filePath.replace(/^\/+/, '')}`;
+    const matchingAsset = Object.values(ExpoUpdates.localAssets ?? {}).find((asset) =>
+      asset.split(/[?#]/, 1)[0].endsWith(normalizedFilePath)
+    );
+    if (matchingAsset) {
+      return matchingAsset;
+    }
+  }
+  return `${getBaseURL()}/${filePath}`;
+}
+
 
